{
  "expo": {
    "name": "BirdPulse",
    "slug": "birdpulse",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "birdpulse",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fatah.birdpulse",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "NSCameraUsageDescription": "Capture photos of birds to identify them",
        "NSMicrophoneUsageDescription": "Record bird calls to identify species",
        "NSPhotoLibraryUsageDescription": "Pick bird photos to identify species",
        "NSLocationWhenInUseUsageDescription": "Show birds near you and log sightings"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0E0F0D"
      },
      "edgeToEdgeEnabled": true,
      "versionCode": 13,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "com.android.vending.BILLING"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0E0F0D"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Capture photos of birds to identify them",
          "microphonePermission": "Record bird calls to identify species"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Pick bird photos to identify species"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Show birds near you and log sightings"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Record bird calls to identify species"
        }
      ],
      "expo-font",
      "expo-asset",
      "@react-native-firebase/app",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "buildReactNativeFromSource": false,
            "extraPods": [
              { "name": "GoogleUtilities", "modular_headers": true }
            ]
          }
        }
      ],
      "./plugins/withFirebaseModularFix"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
