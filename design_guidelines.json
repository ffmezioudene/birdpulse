      "shimmer_color": "#7BA05B",
      "radar_glow": "rgba(123, 160, 91, 0.5)",
      "confidence_meter": "#7BA05B"
    }
  },
  "motion": {
    "spring": {
      "damping": 20,
      "stiffness": 200,
      "mass": 1
    },
    "transitions": {
      "fast": "0.2s ease",
      "medium": "0.4s cubic-bezier(0.16, 1, 0.3, 1)",
      "slow": "0.8s cubic-bezier(0.16, 1, 0.3, 1)"
    }
