      "border_top": "1px solid rgba(255, 255, 255, 0.08)",
      "fab": {
        "position": "center_elevated",
        "shape": "circle",
        "background": "#7BA05B",
        "shadow": "0px 8px 32px rgba(123, 160, 91, 0.4)"
