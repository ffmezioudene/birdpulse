    "buttons": {
      "primary": {
        "background": "#7BA05B",
        "text": "#FFFFFF",
        "border_radius": 16,
        "padding": "16px 24px"
      },
      "secondary": {
        "background": "transparent",
        "border": "1px solid rgba(255, 255, 255, 0.15)",
        "text": "#FFFFFF",
        "border_radius": 16,
        "padding": "16px 24px"
      },
      "premium": {
        "background": "#E0A458",
        "text": "#0E0F0D",
        "border_radius": 16,
        "padding": "16px 24px",
        "shadow": "0px 8px 32px rgba(224, 164, 88, 0.3)"
      }
    },
    "chips": {
      "background": "rgba(255, 255, 255, 0.1)",
      "text": "#FFFFFF",
      "border_radius": 9999,
      "padding": "8px 16px"
